{
  "expo": {
    "name": "Boulder Log",
    "slug": "boulder-log",
    "scheme": "boulderlog",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#201E1C"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Boulder Log uses your camera to photograph boulder problems."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#201E1C"
      },
      "permissions": ["CAMERA"]
    },
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": ["expo-router"]
  }
}
